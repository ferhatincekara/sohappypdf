# =============================================================================
# SoHappyPDF — environment template
# Copy to .env and fill in the required values. Do not commit .env.
# =============================================================================


# -----------------------------------------------------------------------------
# Web (apps/web — Next.js public env)
# These are exposed to the browser. Never put secrets here.
# -----------------------------------------------------------------------------

# Public site URL. Default: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public API origin. Separate host from the web app, not APP_URL/api.
# Default: http://localhost:3001
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Client-side upload ceiling in bytes. Default: 1073741824 (1 GiB)
NEXT_PUBLIC_MAX_UPLOAD_FILE_SIZE=1073741824


# -----------------------------------------------------------------------------
# App / billing URL
# -----------------------------------------------------------------------------

# Canonical app URL used for Polar redirects. Falls back to NEXT_PUBLIC_APP_URL.
APP_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# Database (Neon / PostgreSQL)
# Required. Apply migrations with: bun run db:migrate
# -----------------------------------------------------------------------------

DATABASE_URL=postgresql://user:password@localhost:5432/sohappypdf


# -----------------------------------------------------------------------------
# Auth (Better Auth)
# Required. Secret must be at least 32 characters.
# Generate: openssl rand -base64 32
# -----------------------------------------------------------------------------

BETTER_AUTH_SECRET=

# Auth base URL (API origin). Must be HTTPS in production.
BETTER_AUTH_URL=http://localhost:3001

# Optional. Session cookie Domain for split web/API hosts.
# Production default from api.sohappypdf.com is sohappypdf.com.
# AUTH_COOKIE_DOMAIN=sohappypdf.com

# Optional. Google OAuth (Better Auth). Both values are required together.
# Google Cloud → APIs & Services → Credentials → Web client.
# Authorized JavaScript origins: APP_URL and BETTER_AUTH_URL origins.
# Authorized redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=


# -----------------------------------------------------------------------------
# Email (Resend — password reset)
# Optional for local tool work. Required to send "forgot password" mail.
# Verify the from domain in the Resend dashboard.
# Local test sender: SoHappyPDF <beth.t@example.com>
# -----------------------------------------------------------------------------

RESEND_API_KEY=

# Default: SoHappyPDF <noreply@sohappypdf.com>
RESEND_FROM_EMAIL=


# -----------------------------------------------------------------------------
# API (apps/api)
# -----------------------------------------------------------------------------

# Comma-separated allowed origins. Do not use *.
# Example local: http://localhost:3000
API_CORS_ORIGINS=http://localhost:3000


# -----------------------------------------------------------------------------
# Storage (AWS S3)
# Required for uploads and downloads.
# -----------------------------------------------------------------------------

AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
# The API syncs bucket CORS for browser uploads (apex + www).
# The IAM user needs s3:GetBucketCors and s3:PutBucketCors.


# -----------------------------------------------------------------------------
# Redis / queue / rate limits (Upstash)
# Required for BullMQ. Rate limiting uses the same REST credentials.
# -----------------------------------------------------------------------------

UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=


# -----------------------------------------------------------------------------
# Rate limits (optional — defaults shown)
# Requests per minute.
# -----------------------------------------------------------------------------

# Anonymous web: 30
RATE_LIMIT_ANONYMOUS_PER_MINUTE=30

# Authenticated Pro web: 120
RATE_LIMIT_AUTHENTICATED_PER_MINUTE=120

# Authenticated Free web: 60
RATE_LIMIT_FREE_AUTHENTICATED_PER_MINUTE=60

# API Pro: 60
RATE_LIMIT_API_PER_MINUTE=60

# API Free: 30
RATE_LIMIT_FREE_API_PER_MINUTE=30


# -----------------------------------------------------------------------------
# Files (temporary processing, ~2 hours)
# Sizes are in bytes. Retention is in hours.
# -----------------------------------------------------------------------------

# Server-side upload ceiling. Default: 1073741824 (1 GiB)
MAX_UPLOAD_FILE_SIZE=1073741824

# How long temporary files stay available. Default: 2
FILE_RETENTION_HOURS=2

# Cleanup batch size (max 100). Default: 100
FILE_CLEANUP_BATCH_SIZE=100


# -----------------------------------------------------------------------------
# Worker (apps/worker)
# Optional — defaults shown. Health server listens on WORKER_HEALTH_PORT.
# -----------------------------------------------------------------------------

# Parallel conversions. Default: 1
WORKER_CONCURRENCY=1

# Conversion timeout in milliseconds. Default: 120000 (2 min)
CONVERSION_TIMEOUT_MS=120000

# Graceful shutdown wait. Default: conversion timeout + 10s
WORKER_SHUTDOWN_TIMEOUT_MS=130000

# Worker health HTTP port. Default: 8080
WORKER_HEALTH_PORT=8080

# Worker health HTTP URL. Default: http://localhost:8080
WORKER_HEALTH_URL=http://localhost:8080

# Worker file size / disk limits in bytes.
# Defaults: input 1 GiB, output 1.5 GiB, temp disk 3 GiB
MAX_INPUT_FILE_SIZE=1073741824
MAX_OUTPUT_FILE_SIZE=1610612736
MAX_TEMP_DISK_USAGE=3221225472

# Conversion binary names (PATH). Defaults: qpdf, ocrmypdf
QPDF_BIN=qpdf
OCRMY_PDF_BIN=ocrmypdf


# -----------------------------------------------------------------------------
# Billing (Polar.sh)
# Optional for local tool work. Required for checkout and webhooks.
# Local webhooks cannot reach localhost; billing status reconciles on page load.
# Polar uses one product per billing interval. Checkout sends monthly + yearly.
# -----------------------------------------------------------------------------

# sandbox | production. Default: sandbox
POLAR_SERVER=sandbox

POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=

# Web Pro
POLAR_PRO_PRODUCT_ID=
POLAR_PRO_YEARLY_PRODUCT_ID=

# Public API plans
POLAR_API_STARTER_PRODUCT_ID=
POLAR_API_STARTER_YEARLY_PRODUCT_ID=
POLAR_API_GROWTH_PRODUCT_ID=
POLAR_API_GROWTH_YEARLY_PRODUCT_ID=
POLAR_API_SCALE_PRODUCT_ID=
POLAR_API_SCALE_YEARLY_PRODUCT_ID=


# -----------------------------------------------------------------------------
# Credits (optional — monthly allotments, defaults shown)
# -----------------------------------------------------------------------------

# Web tools. Defaults: Free 1550, Pro 2000
FREE_WEB_TOOL_CREDITS=1550
PRO_WEB_TOOL_CREDITS=2000

# AI. Defaults: Free 0, Pro 200
FREE_AI_CREDITS=0
PRO_AI_CREDITS=200

# Public API plans. Defaults: Starter 2000, Growth 10000, Scale 100000
API_STARTER_CREDITS=2000
API_GROWTH_CREDITS=10000
API_SCALE_CREDITS=100000
