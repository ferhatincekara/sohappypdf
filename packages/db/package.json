{
  "name": "@sohappypdf/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "check-types": "tsc --noEmit",
    "db:generate": "bun --env-file=../../.env drizzle-kit generate",
    "db:migrate": "bun --env-file=../../.env run src/migrate.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@sohappypdf/config": "workspace:*",
    "@sohappypdf/core": "workspace:*",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@sohappypdf/typescript-config": "workspace:*",
    "@types/node": "^22.18.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "5.9.2"
  }
}
